# Cloudflare R2 Configuration
# Required for document upload functionality in the apostille service

# Your Cloudflare account ID
# Find this in your Cloudflare dashboard under Account ID
R2_ACCOUNT_ID=your_account_id_here

# R2 Access Key ID
# Create these in Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=your_access_key_here

# R2 Secret Access Key
# Generated when you create the R2 API token
R2_SECRET_ACCESS_KEY=your_secret_key_here

# R2 Bucket Name
# The name of the bucket where documents will be stored
R2_BUCKET=sealwright-documents
