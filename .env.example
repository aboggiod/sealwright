# ZIPCodeBase API Key (for zip code to city/state lookup)
# Get free key at: https://zipcodebase.com/ (10k requests/month free)
NEXT_PUBLIC_ZIPCODE_API_KEY=your_zipcodebase_api_key_here

# USPS API Key (for address validation)
# Register at: https://www.usps.com/business/web-tools-apis/
USPS_USER_ID=your_usps_user_id_here
